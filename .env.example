# =============================================================
# Variáveis de Ambiente — RP5 Monitoramento Espacial
# =============================================================
# Copie este arquivo para .env e preencha com os valores reais.
# O arquivo .env NÃO deve ser commitado (já está no .gitignore).
# =============================================================

# ── Banco de Dados (PostgreSQL) ──────────────────────────────
POSTGRES_DB=seu_banco
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha_segura

# ── Spring Boot DataSource ───────────────────────────────────
# Para Docker Compose, use "db" como host (nome do serviço).
# Para desenvolvimento local, use "localhost".
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/seu_banco
SPRING_DATASOURCE_USERNAME=seu_usuario
SPRING_DATASOURCE_PASSWORD=sua_senha_segura

# ── JPA / Hibernate ─────────────────────────────────────────
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true