# Copy this file to .env and fill values with private runtime credentials.
# Do not commit real .env files or production secrets.

SPRING_PROFILES_ACTIVE=local

# Local PostgreSQL for Docker Compose development
POSTGRES_DB=monitoramento_espacial
POSTGRES_USER=monitoramento
POSTGRES_PASSWORD=monitoramento_local_password
POSTGRES_PORT=5432

# PostgreSQL / Neon-compatible database.
# For local Compose, keep the defaults below. For Neon, replace only these
# SPRING_DATASOURCE_* values with private credentials.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/monitoramento_espacial
SPRING_DATASOURCE_USERNAME=monitoramento
SPRING_DATASOURCE_PASSWORD=monitoramento_local_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JWT
APP_SECURITY_JWT_SECRET=local-development-jwt-secret-32-chars-minimum
APP_SECURITY_JWT_EXPIRATION_MS=28800000

# Seed users
APP_SECURITY_SEED_ADMIN_USERNAME=admin
APP_SECURITY_SEED_ADMIN_PASSWORD=admin_local_password
APP_SECURITY_SEED_OPERADOR_USERNAME=operador
APP_SECURITY_SEED_OPERADOR_PASSWORD=operador_local_password
APP_SECURITY_SEED_ANALISTA_USERNAME=analista
APP_SECURITY_SEED_ANALISTA_PASSWORD=analista_local_password

# Python simulator
SIMULATOR_API_ENABLED=false
SIMULATOR_API_URL=http://localhost:8000
SIMULATOR_API_CONNECT_TIMEOUT_MS=2000
SIMULATOR_API_READ_TIMEOUT_MS=30000
